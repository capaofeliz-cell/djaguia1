<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<meta name="description" content="Fale com o Pastor Virtual por e-mail ou WhatsApp. Envie sua dúvida, sugestão ou testemunho.">
